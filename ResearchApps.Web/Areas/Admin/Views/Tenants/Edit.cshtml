@using ResearchApps.Common.Constants
@using ResearchApps.Web.Areas.Admin.Controllers
@model TenantsController.EditTenantVm

@{
    ViewBag.Title = "Edit Tenant";
    ViewBag.pTitle = "Edit Tenant";
    Layout = "_Layout";
    var sections = TenantFeatureConstants.GetAllBySection();
}

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0">Edit Tenant</h5>
        <small class="text-muted float-end">Tenant Update</small>
    </div>
    <div class="card-body">
        <form id="edit-tenant-form" asp-area="Admin" asp-controller="Tenants" asp-action="Edit" method="post"
              x-data="tenantFeatures()" x-init="init()">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="row mb-4">
                <label asp-for="Name" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-4">
                <label asp-for="Identifier" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="Identifier" class="form-control" placeholder="e.g. acme" />
                    <span asp-validation-for="Identifier" class="text-danger"></span>
                    <small class="form-text text-muted">Lowercase alphanumeric with optional hyphens.</small>
                </div>
            </div>
            <div class="row mb-4">
                <label asp-for="ConnectionString" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <textarea asp-for="ConnectionString" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="ConnectionString" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-4">
                <label asp-for="IsActive" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    </div>
                </div>
            </div>
            <div class="row mb-4">
                <label asp-for="LogoUrl" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="LogoUrl" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="LogoUrl" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-4">
                <label asp-for="MaxUsers" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="MaxUsers" class="form-control" type="number" min="0" />
                    <span asp-validation-for="MaxUsers" class="text-danger"></span>
                    <small class="form-text text-muted">Maximum number of users allowed for this tenant. Set to 0 for unlimited.</small>
                </div>
            </div>

            <!-- Features -->
            <hr class="my-4" />
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="mb-0">Enabled Features</h6>
                <button type="button" class="btn btn-sm btn-outline-primary" @@click="toggleAll()">
                    <span x-text="allSelected ? 'Deselect All' : 'Select All'"></span>
                </button>
            </div>
            <div class="row">
                @foreach (var grp in sections)
                {
                    <div class="col-md-6 col-xl-4 mb-4">
                        <div class="card border shadow-none mb-0">
                            <div class="card-header bg-light d-flex align-items-center justify-content-between py-2">
                                <h6 class="card-title mb-0 fs-13">@grp.Key</h6>
                                <div class="form-check form-switch mb-0">
                                    <input type="checkbox" class="form-check-input"
                                           @@change="toggleSection('@grp.Key')"
                                           :checked="isSectionFullySelected('@grp.Key')" />
                                </div>
                            </div>
                            <div class="card-body py-2">
                                @foreach (var feature in grp.Value)
                                {
                                    <div class="form-check mb-1">
                                        <input class="form-check-input" type="checkbox"
                                               name="EnabledFeatures"
                                               value="@feature.Key"
                                               id="feature_@feature.Key"
                                               :checked="features.includes('@feature.Key')"
                                               @@change="toggleFeature('@feature.Key', $event)" />
                                        <label class="form-check-label" for="feature_@feature.Key">@feature.DisplayName</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="row justify-content-start">
                <div class="col-sm-12">
                    <button type="button" class="btn btn-primary" id="update-tenant-btn">Update Tenant</button>
                    <a asp-area="Admin" asp-controller="Tenants" asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Confirmation Modal -->
<div id="updateTenantModal" class="modal fade zoomIn" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you sure?</h4>
                        <p class="text-muted mx-4 mb-0">Are you sure you want to update this tenant?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-light" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-primary" id="confirm-update-tenant">Yes, Update It!</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function tenantFeatures() {
            const sectionMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                sections.ToDictionary(s => s.Key, s => s.Value.Select(f => f.Key).ToList())));
            const allKeys = Object.values(sectionMap).flat();
            return {
                features: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EnabledFeatures)),
                get allSelected() { return allKeys.every(k => this.features.includes(k)); },
                init() {},
                toggleFeature(key, e) {
                    if (e.target.checked) {
                        if (!this.features.includes(key)) this.features.push(key);
                    } else {
                        this.features = this.features.filter(k => k !== key);
                    }
                },
                toggleSection(section) {
                    const keys = sectionMap[section];
                    const allOn = keys.every(k => this.features.includes(k));
                    if (allOn) {
                        this.features = this.features.filter(k => !keys.includes(k));
                    } else {
                        keys.forEach(k => { if (!this.features.includes(k)) this.features.push(k); });
                    }
                },
                isSectionFullySelected(section) {
                    return sectionMap[section].every(k => this.features.includes(k));
                },
                toggleAll() {
                    if (this.allSelected) { this.features = []; } else { this.features = [...allKeys]; }
                }
            };
        }

        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('edit-tenant-form');
            const btn = document.getElementById('update-tenant-btn');
            const confirmBtn = document.getElementById('confirm-update-tenant');
            const modal = new bootstrap.Modal(document.getElementById('updateTenantModal'));

            btn.addEventListener('click', function () {
                if (form.checkValidity()) {
                    modal.show();
                } else {
                    form.reportValidity();
                }
            });

            confirmBtn.addEventListener('click', function () {
                modal.hide();
                form.submit();
            });
        });
    </script>
}
