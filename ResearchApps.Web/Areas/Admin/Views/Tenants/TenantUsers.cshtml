@using ResearchApps.Common.Constants
@using ResearchApps.Web.Services
@model List<TenantUserItem>

@{
    ViewBag.Title = $"Users — {ViewBag.TenantName}";
    ViewBag.pTitle = "Tenant User Management";
    Layout = "_Layout";
}

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-0">Users — @ViewBag.TenantName</h5>
            @if ((int)ViewBag.MaxUsers > 0)
            {
                var atLimit = (int)ViewBag.UserCount >= (int)ViewBag.MaxUsers;
                <small class="text-@(atLimit ? "danger" : "muted")">@ViewBag.UserCount / @ViewBag.MaxUsers users</small>
            }
            else
            {
                <small class="text-muted">@ViewBag.UserCount users</small>
            }
        </div>
        <div>
            @if ((int)ViewBag.MaxUsers == 0 || (int)ViewBag.UserCount < (int)ViewBag.MaxUsers)
            {
                <a asp-area="Admin" asp-controller="Tenants" asp-action="CreateTenantUser" asp-route-id="@ViewBag.TenantId"
                   class="btn btn-sm btn-primary">
                    <i class="ri-add-line me-1"></i> Create User
                </a>
            }
            else
            {
                <button class="btn btn-sm btn-secondary" disabled title="User limit reached">
                    <i class="ri-add-line me-1"></i> Create User
                </button>
            }
            <a asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@ViewBag.TenantId"
               class="btn btn-sm btn-secondary ms-1">
                Back to Tenant
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th style="min-width: 200px;">User</th>
                    <th style="min-width: 200px;">Email</th>
                    <th style="min-width: 120px;">Roles</th>
                    <th style="width: 100px;">Status</th>
                    <th class="text-center" style="width: 120px;">Actions</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Any())
                {
                    foreach (var user in Model)
                    {
                        var initials = ((user.FirstName.Length > 0 ? user.FirstName[..1] : "") + (user.LastName.Length > 0 ? user.LastName[..1] : "")).Trim();
                        var fullName = $"{user.FirstName} {user.LastName}".Trim();
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0 me-3">
                                        <div class="avatar-xs">
                                            <span class="avatar-title rounded-circle bg-primary-subtle text-primary">@initials</span>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h5 class="fs-14 mb-0">@fullName</h5>
                                        <p class="text-muted mb-0">@user.UserName</p>
                                    </div>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary">@(string.IsNullOrEmpty(user.Roles) ? "No Role" : user.Roles)</span>
                            </td>
                            <td>
                                @if (user.Active)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-soft-warning"
                                        title="Reset Password"
                                        data-bs-toggle="modal"
                                        data-bs-target="#resetPasswordModal"
                                        data-userid="@user.Id"
                                        data-username="@user.UserName">
                                    <i class="ri-lock-password-line align-bottom"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="ri-inbox-line fs-2"></i>
                            <p class="mb-0 mt-2">No users found</p>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="Tenants" asp-action="ResetTenantUserPassword" asp-route-id="@ViewBag.TenantId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="resetUserId" />
                <div class="modal-header">
                    <h5 class="modal-title">Reset Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Resetting password for <strong id="resetUsername"></strong></p>
                    <div class="mb-3">
                        <label for="newPassword" class="form-label">New Password</label>
                        <input type="password" class="form-control" id="newPassword" name="newPassword" required minlength="6" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
<script>
    document.getElementById('resetPasswordModal')?.addEventListener('show.bs.modal', function(event) {
        var button = event.relatedTarget;
        document.getElementById('resetUserId').value = button.getAttribute('data-userid');
        document.getElementById('resetUsername').textContent = button.getAttribute('data-username');
        document.getElementById('newPassword').value = '';
    });
</script>
}
