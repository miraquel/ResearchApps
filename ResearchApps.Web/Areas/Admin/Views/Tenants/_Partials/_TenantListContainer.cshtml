@using ResearchApps.Common.Constants
@using ResearchApps.Web.Areas.Admin.Controllers
@model TenantsController.TenantListVm

<table class="table table-bordered table-hover align-middle mb-0" style="width: 100%;">
    <thead class="table-light">
    <tr>
        <th class="sortable-header" style="min-width: 150px; cursor: pointer;"
            @@click="sort('Name')" data-column="Name">
            <div class="d-flex align-items-center">
                <span>Name</span>
                <template x-if="sortBy === 'Name'">
                    <i :class="sortAsc ? 'ri-arrow-up-s-line' : 'ri-arrow-down-s-line'" class="ms-1"></i>
                </template>
            </div>
        </th>
        <th class="sortable-header" style="min-width: 120px; cursor: pointer;"
            @@click="sort('Identifier')" data-column="Identifier">
            <div class="d-flex align-items-center">
                <span>Identifier</span>
                <template x-if="sortBy === 'Identifier'">
                    <i :class="sortAsc ? 'ri-arrow-up-s-line' : 'ri-arrow-down-s-line'" class="ms-1"></i>
                </template>
            </div>
        </th>
        <th class="sortable-header" style="width: 100px; cursor: pointer;"
            @@click="sort('IsActive')" data-column="IsActive">
            <div class="d-flex align-items-center">
                <span>Status</span>
                <template x-if="sortBy === 'IsActive'">
                    <i :class="sortAsc ? 'ri-arrow-up-s-line' : 'ri-arrow-down-s-line'" class="ms-1"></i>
                </template>
            </div>
        </th>
        <th class="sortable-header" style="min-width: 140px; cursor: pointer;"
            @@click="sort('CreatedDate')" data-column="CreatedDate">
            <div class="d-flex align-items-center">
                <span>Created</span>
                <template x-if="sortBy === 'CreatedDate'">
                    <i :class="sortAsc ? 'ri-arrow-up-s-line' : 'ri-arrow-down-s-line'" class="ms-1"></i>
                </template>
            </div>
        </th>
        <th class="text-center" style="width: 140px;">Actions</th>
    </tr>
    </thead>
    <tbody id="tenant-table-body">
        @await Html.PartialAsync("_Partials/_TenantListPartial", Model)
    </tbody>
    <tfoot class="table-light">
    <tr>
        <td>
            <input type="text" class="form-control form-control-sm" placeholder="Search name..."
                   x-model="filters.Name" @@input.debounce.500ms="fetchList()">
        </td>
        <td>
            <input type="text" class="form-control form-control-sm" placeholder="Search identifier..."
                   x-model="filters.Identifier" @@input.debounce.500ms="fetchList()">
        </td>
        <td>
            <select class="form-select form-select-sm" x-model="filters.IsActive" @@change="fetchList()">
                <option value="">All</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </td>
        <td></td>
        <td class="text-center">
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    @@click="clearFilters()" title="Clear All Filters">
                <i class="ri-filter-off-line"></i>
            </button>
        </td>
    </tr>
    </tfoot>
</table>

<div class="mt-3">
    @await Html.PartialAsync("_Partials/_TenantPaginationPartial", Model)
</div>
