@using ResearchApps.Web.Areas.Admin.Controllers
@model RolesController.RolePermissionsVm

@{
    ViewBag.Title = "Assign Permissions to Role";
    ViewBag.pTitle = "Assign Permissions to Role";
    Layout = "_Layout";

    var moduleBlocks = Model.ModuleGroupedPermissions;
}

<div class="card">
    <div class="card-body">
        <div class="mb-3">
            <span class="text-muted me-2">Editing Role:</span>
            <span class="badge bg-primary-subtle text-primary fs-6">@Model.RoleName</span>
        </div>
        <form id="role-permissions-form" asp-area="Admin" asp-controller="Roles" asp-action="RolePermissions" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="RoleId" />
            <div class="mb-3">
                @foreach (var module in moduleBlocks)
                {
                    var moduleSlug = module.Key.Replace(" ", "_");
                    var moduleClass = $"module_{moduleSlug}";
                    var allModuleChecked = module.Value.All(g => g.Value.All(p => Model.SelectedPermissions.Contains(p)));

                    <div class="card mb-3 border">
                        <div class="card-header bg-light">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="mb-0">@module.Key</h6>
                                </div>
                                <div class="flex-shrink-0 d-flex align-items-center">
                                    <span class="badge bg-secondary me-2">@module.Value.Count group(s)</span>
                                    <button type="button" class="btn btn-label-facebook btn-sm" onclick="toggleModule('@moduleClass', this)">
                                        <span class="bi bi-check2-square pe-2"></span>
                                        <span class="toggle-label">@(allModuleChecked ? "Uncheck Module" : "Check Module")</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            @foreach (var group in module.Value)
                            {
                                var groupId = $"group_{moduleSlug}_{group.Key}";
                                var collapseId = $"collapse_{moduleSlug}_{group.Key}";
                                var allChecked = group.Value.All(p => Model.SelectedPermissions.Contains(p));

                                <div class="mb-2">
                                    <div class="card border">
                                        <div class="card-header p-2 ps-3 bg-gradient-primary">
                                            <div class="d-flex align-items-center">
                                                <div class="flex-grow-1 d-flex align-items-center">
                                                    <button class="btn p-0 me-2" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="true" aria-controls="@collapseId">
                                                        <span class="bi bi-chevron-down"></span>
                                                    </button>
                                                    <strong class="me-2">@RolesController.GetGroupFriendlyName(group.Key)</strong>
                                                </div>
                                                <div class="flex-shrink-0">
                                                    <button type="button" class="btn btn-label-facebook btn-sm ms-2" onclick="toggleGroup('@groupId', this)">
                                                        <span class="bi bi-check2-square pe-2"></span>
                                                        <span class="toggle-label">@(allChecked ? "Uncheck All" : "Check All")</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-body p-4 collapse show" id="@collapseId">
                                            <div class="row">
                                                @foreach (var permission in group.Value)
                                                {
                                                    var permId = $"perm_{permission.Replace(".", "_")}";
                                                    <div class="col-md-4 align-middle">
                                                        <div class="form-check">
                                                            <input class="form-check-input @groupId @moduleClass"
                                                                   type="checkbox"
                                                                   name="SelectedPermissions"
                                                                   value="@permission"
                                                                   id="@permId"
                                                                   @(Model.SelectedPermissions.Contains(permission) ? "checked" : "") />
                                                            <label class="form-check-label fw-bold" for="@permId">
                                                                @RolesController.GetPermissionFriendlyName(permission)
                                                            </label>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="row justify-content-end">
                <div class="col">
                    <button type="button" class="btn btn-primary" id="save-permissions-btn">Save Permissions</button>
                    <a asp-area="Admin" asp-controller="Roles" asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Confirmation Modal -->
<div id="savePermissionsModal" class="modal fade zoomIn" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon
                        src="https://cdn.lordicon.com/exymduqj.json"
                        trigger="loop"
                        delay="2000"
                        stroke="light"
                        state="hover-line"
                        style="width:100px;height:100px">
                    </lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you sure?</h4>
                        <p class="text-muted mx-4 mb-0">Are you sure you want to update the permissions for this role?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-light" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-primary" id="confirm-save-permissions">Yes, Save It!</button>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('role-permissions-form');
            const btn = document.getElementById('save-permissions-btn');
            const confirmBtn = document.getElementById('confirm-save-permissions');

            btn.addEventListener('click', function () {
                const modal = new bootstrap.Modal(document.getElementById('savePermissionsModal'));
                modal.show();
            });

            confirmBtn.addEventListener('click', function () {
                form.submit();
            });
        });

        function toggleGroup(groupClass, btn) {
            const checkboxes = document.getElementsByClassName(groupClass);
            let allChecked = true;
            for (let i = 0; i < checkboxes.length; i++) {
                if (!checkboxes[i].checked) {
                    allChecked = false;
                    break;
                }
            }
            const newState = !allChecked;
            for (let i = 0; i < checkboxes.length; i++) {
                checkboxes[i].checked = newState;
            }
            const label = btn.querySelector('.toggle-label');
            if (label) {
                label.textContent = newState ? "Uncheck All" : "Check All";
            }
        }

        function toggleModule(moduleClass, btn) {
            const checkboxes = document.getElementsByClassName(moduleClass);
            let allChecked = true;
            for (let i = 0; i < checkboxes.length; i++) {
                if (!checkboxes[i].checked) {
                    allChecked = false;
                    break;
                }
            }

            const newState = !allChecked;
            for (let i = 0; i < checkboxes.length; i++) {
                checkboxes[i].checked = newState;
            }

            const label = btn.querySelector('.toggle-label');
            if (label) {
                label.textContent = newState ? "Uncheck Module" : "Check Module";
            }
        }
    </script>
}
