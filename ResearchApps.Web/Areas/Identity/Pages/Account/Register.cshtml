@page
@model RegisterModel
@{
    ViewData["Title"] = "Registration Unavailable";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <h1>@ViewData["Title"]</h1>
        <p class="lead">Self-registration is not available. Please contact your administrator for an account.</p>
        <a asp-page="./Login" class="btn btn-primary">Go to Login</a>
    </div>
</div>
