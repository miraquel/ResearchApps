@model ResearchApps.Service.Vm.DashboardVm
@{
    ViewBag.Title = "Dashboard";
    ViewBag.pTitle = "Dashboard";
    Layout = "_Layout";
    var mc = Model.ModuleCounts;
}

<!-- Row 1: Module KPI Cards -->
<div class="row g-2">
    <!-- Sales: Customer Orders -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate border shadow-sm mb-2 dashboard-kpi-card">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-uppercase fw-medium text-muted text-truncate mb-1 fs-12">Customer Orders</p>
                        <h5 class="fs-16 fw-semibold mb-0">@mc.ActiveCos.ToString("N0") <span class="fs-11 text-muted fw-normal">active</span></h5>
                    </div>
                    <div class="avatar-xs flex-shrink-0">
                        <span class="avatar-title bg-info-subtle rounded fs-5">
                            <i class="ri-shopping-cart-line text-info"></i>
                        </span>
                    </div>
                </div>
                <div class="mt-1">
                    @if (mc.OutstandingCos > 0)
                    {
                        <span class="badge bg-warning-subtle text-warning fs-10">@mc.OutstandingCos outstanding</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success fs-10">All fulfilled</span>
                    }
                    <span class="text-muted fs-11 ms-1">@mc.TotalCos total</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Sales: Delivery Orders -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate border shadow-sm mb-2 dashboard-kpi-card">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-uppercase fw-medium text-muted text-truncate mb-1 fs-12">Delivery Orders</p>
                        <h5 class="fs-16 fw-semibold mb-0">@mc.TotalDos.ToString("N0") <span class="fs-11 text-muted fw-normal">total</span></h5>
                    </div>
                    <div class="avatar-xs flex-shrink-0">
                        <span class="avatar-title bg-info-subtle rounded fs-5">
                            <i class="ri-truck-line text-info"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sales: Invoices & Revenue -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate border shadow-sm mb-2 dashboard-kpi-card">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-uppercase fw-medium text-muted text-truncate mb-1 fs-12">Sales Invoices</p>
                        <h5 class="fs-16 fw-semibold mb-0">@mc.TotalSis.ToString("N0")</h5>
                    </div>
                    <div class="avatar-xs flex-shrink-0">
                        <span class="avatar-title bg-info-subtle rounded fs-5">
                            <i class="ri-money-dollar-circle-line text-info"></i>
                        </span>
                    </div>
                </div>
                <div class="mt-1">
                    <span class="text-muted fs-11">Revenue: <span class="fw-medium text-dark">@mc.SiRevenue.ToString("C0")</span></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Procurement: PRs -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate border shadow-sm mb-2 dashboard-kpi-card">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-uppercase fw-medium text-muted text-truncate mb-1 fs-12">Purchase Requisitions</p>
                        <h5 class="fs-16 fw-semibold mb-0">@mc.TotalPrs.ToString("N0") <span class="fs-11 text-muted fw-normal">total</span></h5>
                    </div>
                    <div class="avatar-xs flex-shrink-0">
                        <span class="avatar-title bg-success-subtle rounded fs-5">
                            <i class="ri-file-list-3-line text-success"></i>
                        </span>
                    </div>
                </div>
                <div class="mt-1">
                    <span class="badge bg-warning-subtle text-warning fs-10">@mc.PendingPrs pending</span>
                    <span class="badge bg-success-subtle text-success fs-10">@mc.ApprovedPrs approved</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Row 2: More Module KPIs -->
<div class="row g-2">
    <!-- Procurement: POs -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate border shadow-sm mb-2">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-uppercase fw-medium text-muted text-truncate mb-1 fs-12">Purchase Orders</p>
                        <h5 class="fs-16 fw-semibold mb-0">@mc.TotalPos.ToString("N0") <span class="fs-11 text-muted fw-normal">total</span></h5>
                    </div>
                    <div class="avatar-xs flex-shrink-0">
                        <span class="avatar-title bg-success-subtle rounded fs-5">
                            <i class="ri-shopping-bag-line text-success"></i>
                        </span>
                    </div>
                </div>
                <div class="mt-1">
                    @if (mc.OutstandingPos > 0)
                    {
                        <span class="badge bg-warning-subtle text-warning fs-10">@mc.OutstandingPos active</span>
                    }
                    <span class="text-muted fs-11 ms-1">@mc.TotalGrs GRs received</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Inventory: Items -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate border shadow-sm mb-2">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-uppercase fw-medium text-muted text-truncate mb-1 fs-12">Active Items</p>
                        <h5 class="fs-16 fw-semibold mb-0">@mc.ActiveItems.ToString("N0")</h5>
                    </div>
                    <div class="avatar-xs flex-shrink-0">
                        <span class="avatar-title bg-warning-subtle rounded fs-5">
                            <i class="ri-archive-line text-warning"></i>
                        </span>
                    </div>
                </div>
                <div class="mt-1">
                    @if (mc.LowStockCount > 0)
                    {
                        <span class="badge bg-danger-subtle text-danger fs-10"><i class="ri-alert-line"></i> @mc.LowStockCount low stock</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success fs-10">Stock OK</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Production -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate border shadow-sm mb-2">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-uppercase fw-medium text-muted text-truncate mb-1 fs-12">Production Orders</p>
                        <h5 class="fs-16 fw-semibold mb-0">@mc.ActiveProds.ToString("N0") <span class="fs-11 text-muted fw-normal">active</span></h5>
                    </div>
                    <div class="avatar-xs flex-shrink-0">
                        <span class="avatar-title bg-secondary-subtle rounded fs-5">
                            <i class="ri-tools-line text-secondary"></i>
                        </span>
                    </div>
                </div>
                <div class="mt-1">
                    <span class="text-muted fs-11">@mc.TotalProds total</span>
                </div>
            </div>
        </div>
    </div>

    <!-- My Approvals -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate border shadow-sm mb-2 @(mc.MyPendingApprovals > 0 ? "border-warning" : "")">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-uppercase fw-medium text-muted text-truncate mb-1 fs-12">My Pending Approvals</p>
                        <h5 class="fs-16 fw-semibold mb-0 @(mc.MyPendingApprovals > 0 ? "text-warning" : "text-success")">@mc.MyPendingApprovals.ToString("N0")</h5>
                    </div>
                    <div class="avatar-xs flex-shrink-0">
                        <span class="avatar-title @(mc.MyPendingApprovals > 0 ? "bg-warning-subtle" : "bg-success-subtle") rounded fs-5">
                            <i class="ri-checkbox-circle-line @(mc.MyPendingApprovals > 0 ? "text-warning" : "text-success")"></i>
                        </span>
                    </div>
                </div>
                <div class="mt-1">
                    @if (mc.MyPendingApprovals > 0)
                    {
                        <a href="#pendingApprovals" class="text-warning fs-11 text-decoration-underline">Review now</a>
                    }
                    else
                    {
                        <span class="text-success fs-11">All caught up</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Row 3: Budget Progress Bar -->
<div class="row g-2 mb-2">
    <div class="col-12">
        <div class="card border shadow-sm mb-0">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="fw-medium fs-13">Budget Utilization</span>
                    <span class="fs-12">
                        <span class="fw-semibold">@mc.UsedBudget.ToString("C0")</span>
                        <span class="text-muted">/ @mc.TotalBudget.ToString("C0")</span>
                        <span class="badge @(mc.BudgetUtilizationPercentage > 90 ? "bg-danger" : mc.BudgetUtilizationPercentage > 70 ? "bg-warning" : "bg-success") ms-1">@mc.BudgetUtilizationPercentage.ToString("F1")%</span>
                    </span>
                </div>
                <div class="progress" style="height: 8px;">
                    @{
                        var pct = mc.BudgetUtilizationPercentage;
                        var barClass = pct > 90 ? "bg-danger" : pct > 70 ? "bg-warning" : "bg-success";
                    }
                    <div class="progress-bar @barClass" role="progressbar" style="width: @pct.ToString("F1")%;" aria-valuenow="@pct.ToString("F1")" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="d-flex justify-content-between mt-1">
                    <span class="text-muted fs-11">Available: <span class="fw-medium text-success">@mc.AvailableBudget.ToString("C0")</span></span>
                    @if (mc.UnreadNotifications > 0)
                    {
                        <span class="badge bg-danger-subtle text-danger fs-10"><i class="ri-notification-3-line"></i> @mc.UnreadNotifications unread notifications</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Row 4: Dual Trend Charts -->
<div class="row">
    <!-- Procurement Trend -->
    <div class="col-xl-6">
        <div class="card">
            <div class="card-header py-2">
                <h6 class="card-title mb-0 fs-13">Procurement Trend <span class="text-muted fw-normal">(6 months)</span></h6>
            </div>
            <div class="card-body py-2">
                <canvas id="prTrendChart" style="height: 220px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Sales Trend -->
    <div class="col-xl-6">
        <div class="card">
            <div class="card-header py-2">
                <h6 class="card-title mb-0 fs-13">Sales Trend <span class="text-muted fw-normal">(6 months)</span></h6>
            </div>
            <div class="card-body py-2">
                <canvas id="salesTrendChart" style="height: 220px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Row 5: Three Compact Tables -->
<div class="row">
    <!-- Pending Approvals -->
    <div class="col-xl-4" id="pendingApprovals">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center">
                <h6 class="card-title mb-0 flex-grow-1 fs-13">Pending Approvals</h6>
                <span class="badge bg-warning">@mc.MyPendingApprovals</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover table-nowrap align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 fs-11">PR ID</th>
                                <th class="fs-11">Name</th>
                                <th class="pe-3 fs-11 text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PendingApprovals.Any())
                            {
                                foreach (var a in Model.PendingApprovals)
                                {
                                    <tr>
                                        <td class="ps-3"><a href="@Url.Action("Edit", "Prs", new { id = a.RecId })" class="fw-medium link-primary fs-12">@a.PrId</a></td>
                                        <td class="fs-12 text-truncate" style="max-width: 120px;" title="@a.PrName">@a.PrName</td>
                                        <td class="pe-3 text-end fs-12">@a.Total.ToString("C0")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center text-muted py-3 fs-12">No pending approvals</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Low Stock Items -->
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center">
                <h6 class="card-title mb-0 flex-grow-1 fs-13">Low Stock Alerts</h6>
                @if (mc.LowStockCount > 0)
                {
                    <span class="badge bg-danger">@mc.LowStockCount</span>
                }
                else
                {
                    <span class="badge bg-success">OK</span>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover table-nowrap align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 fs-11">Item</th>
                                <th class="fs-11 text-end">Stock</th>
                                <th class="fs-11 text-end">Buffer</th>
                                <th class="pe-3 fs-11 text-end">Deficit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.LowStockItems.Any())
                            {
                                foreach (var item in Model.LowStockItems)
                                {
                                    <tr>
                                        <td class="ps-3 fs-12 text-truncate" style="max-width: 120px;" title="@item.ItemName">@item.ItemName</td>
                                        <td class="text-end fs-12">@item.CurrentStock.ToString("N0")</td>
                                        <td class="text-end fs-12">@item.BufferStock.ToString("N0")</td>
                                        <td class="pe-3 text-end fs-12 text-danger fw-medium">@item.Deficit.ToString("N0")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3 fs-12">All stock levels OK</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Requested Items -->
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header py-2">
                <h6 class="card-title mb-0 fs-13">Top Requested Items <span class="text-muted fw-normal">(3 mo)</span></h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover table-nowrap align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 fs-11">Item</th>
                                <th class="fs-11 text-end">Requests</th>
                                <th class="pe-3 fs-11 text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopItems.Any())
                            {
                                foreach (var item in Model.TopItems)
                                {
                                    <tr>
                                        <td class="ps-3 fs-12 text-truncate" style="max-width: 120px;" title="@item.ItemName">@item.ItemName</td>
                                        <td class="text-end"><span class="badge bg-primary-subtle text-primary fs-10">@item.RequestCount</span></td>
                                        <td class="pe-3 text-end fs-12">@item.TotalAmount.ToString("C0")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center text-muted py-3 fs-12">No data</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Row 6: Budget Doughnut + Recent PRs -->
<div class="row">
    <!-- Budget by Department -->
    <div class="col-xl-6">
        <div class="card">
            <div class="card-header py-2">
                <h6 class="card-title mb-0 fs-13">Budget by Department</h6>
            </div>
            <div class="card-body py-2">
                <canvas id="budgetDeptChart" style="height: 220px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Recent PRs -->
    <div class="col-xl-6">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center">
                <h6 class="card-title mb-0 flex-grow-1 fs-13">Recent PRs</h6>
                <a href="@Url.Action("Index", "Prs")" class="btn btn-soft-info btn-sm py-0 px-2 fs-11">View All <i class="ri-arrow-right-line align-middle"></i></a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover table-nowrap align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 fs-11">PR ID</th>
                                <th class="fs-11">Name</th>
                                <th class="fs-11">Date</th>
                                <th class="fs-11 text-end">Total</th>
                                <th class="pe-3 fs-11 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentPrs.Any())
                            {
                                foreach (var pr in Model.RecentPrs)
                                {
                                    <tr>
                                        <td class="ps-3"><a href="@Url.Action("Edit", "Prs", new { id = pr.PrId })" class="fw-medium link-primary fs-12">@pr.PrId</a></td>
                                        <td class="fs-12 text-truncate" style="max-width: 100px;" title="@pr.PrName">@pr.PrName</td>
                                        <td class="fs-12">@pr.PrDate.ToString("dd MMM yy")</td>
                                        <td class="text-end fs-12">@pr.Total.ToString("C0")</td>
                                        <td class="pe-3 text-center"><span class="badge bg-@pr.StatusBadge fs-10">@pr.PrStatusName</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3 fs-12">No recent PRs</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section styles {
    <link rel="stylesheet" href="~/assets/css/dashboard-cards.css" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Shared chart defaults
        Chart.defaults.font.size = 11;
        Chart.defaults.plugins.legend.labels.boxWidth = 12;

        // === Procurement Trend Chart ===
        const prTrendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PrTrend));
        new Chart(document.getElementById('prTrendChart').getContext('2d'), {
            type: 'line',
            data: {
                labels: prTrendData.map(d => d.MonthYear),
                datasets: [{
                    label: 'PR Count',
                    data: prTrendData.map(d => d.PrCount),
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.1)',
                    tension: 0.4,
                    fill: true,
                    yAxisID: 'y'
                }, {
                    label: 'Amount',
                    data: prTrendData.map(d => d.TotalAmount),
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.1)',
                    tension: 0.4,
                    fill: true,
                    yAxisID: 'y1'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { position: 'top' } },
                scales: {
                    y: { type: 'linear', position: 'left', title: { display: true, text: 'Count' }, grid: { color: 'rgba(0,0,0,0.05)' } },
                    y1: { type: 'linear', position: 'right', title: { display: true, text: 'Amount' }, grid: { drawOnChartArea: false } }
                }
            }
        });

        // === Sales Trend Chart ===
        const salesTrendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend));
        new Chart(document.getElementById('salesTrendChart').getContext('2d'), {
            type: 'line',
            data: {
                labels: salesTrendData.map(d => d.MonthYear),
                datasets: [{
                    label: 'CO Count',
                    data: salesTrendData.map(d => d.CoCount),
                    borderColor: 'rgb(54, 162, 235)',
                    backgroundColor: 'rgba(54, 162, 235, 0.1)',
                    tension: 0.4,
                    fill: true,
                    yAxisID: 'y'
                }, {
                    label: 'SI Revenue',
                    data: salesTrendData.map(d => d.SiTotal),
                    borderColor: 'rgb(255, 159, 64)',
                    backgroundColor: 'rgba(255, 159, 64, 0.1)',
                    tension: 0.4,
                    fill: true,
                    yAxisID: 'y1'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { position: 'top' } },
                scales: {
                    y: { type: 'linear', position: 'left', title: { display: true, text: 'Count' }, grid: { color: 'rgba(0,0,0,0.05)' } },
                    y1: { type: 'linear', position: 'right', title: { display: true, text: 'Revenue' }, grid: { drawOnChartArea: false } }
                }
            }
        });

        // === Budget by Department Doughnut ===
        const budgetDeptData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BudgetByDepartment));
        const deptColors = [
            'rgba(255, 99, 132, 0.8)', 'rgba(54, 162, 235, 0.8)', 'rgba(255, 206, 86, 0.8)',
            'rgba(75, 192, 192, 0.8)', 'rgba(153, 102, 255, 0.8)', 'rgba(255, 159, 64, 0.8)',
            'rgba(199, 199, 199, 0.8)', 'rgba(83, 102, 255, 0.8)'
        ];
        new Chart(document.getElementById('budgetDeptChart').getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: budgetDeptData.map(d => d.Department),
                datasets: [{
                    data: budgetDeptData.map(d => d.TotalSpent),
                    backgroundColor: deptColors.slice(0, budgetDeptData.length),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right', labels: { font: { size: 10 }, padding: 8 } }
                }
            }
        });
    </script>
}
