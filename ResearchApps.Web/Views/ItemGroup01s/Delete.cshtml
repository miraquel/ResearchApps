@model ResearchApps.Service.Vm.ItemGroup01Vm

@{
    ViewBag.Title = "Delete Item Group 01";
    ViewBag.pTitle = "Delete Item Group 01";
    Layout = "_Layout";
}

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col d-flex justify-content-between align-items-center">
                <ul class="nav nav-border-top nav-border-top-primary" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" data-bs-toggle="tab" href="#overview">Overview</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#log">Log</a>
                    </li>
                </ul>
                <div>
                    <a asp-action="Index" class="btn btn-sm btn-secondary me-2">Cancel</a>
                    <button type="button" class="btn btn-sm btn-danger"
                            data-confirm
                            data-confirm-modal="deleteModal"
                            data-confirm-form="#delete-itemgroup01-form"
                            data-confirm-title="Confirm Delete"
                            data-confirm-message="Are you sure you want to delete this item group? This action cannot be undone.">
                        <i class="ri-delete-bin-line"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body">
        <form asp-action="Delete" method="post" id="delete-itemgroup01-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ItemGroup01Id" />
        </form>

        <div class="alert alert-danger mb-4">
            <i class="ri-error-warning-line me-2"></i>
            <strong>Warning:</strong> You are about to delete this item group. This action cannot be undone.
        </div>

        <div class="tab-content">
            <div class="tab-pane active" id="overview" role="tabpanel">
                <div class="row mb-4">
                    <div class="col-3"><strong>@Html.DisplayNameFor(m => m.ItemGroup01Id)</strong></div>
                    <div class="col-9">@Model.ItemGroup01Id</div>
                </div>
                <div class="row mb-4">
                    <div class="col-3"><strong>@Html.DisplayNameFor(m => m.ItemGroup01Name)</strong></div>
                    <div class="col-9">@Model.ItemGroup01Name</div>
                </div>
                <div class="row mb-4">
                    <div class="col-3"><strong>@Html.DisplayNameFor(m => m.StatusId)</strong></div>
                    <div class="col-9">@Model.StatusId</div>
                </div>
                <div class="row mb-4">
                    <div class="col-3"><strong>@Html.DisplayNameFor(m => m.StatusName)</strong></div>
                    <div class="col-9">@Model.StatusName</div>
                </div>
            </div>
            <div class="tab-pane" id="log" role="tabpanel">
                <div class="row mb-4">
                    <div class="col-3"><strong>@Html.DisplayNameFor(m => m.CreatedDate)</strong></div>
                    <div class="col-9">@Model.CreatedDate</div>
                </div>
                <div class="row mb-4">
                    <div class="col-3"><strong>@Html.DisplayNameFor(m => m.CreatedBy)</strong></div>
                    <div class="col-9">@Model.CreatedBy</div>
                </div>
                <div class="row mb-4">
                    <div class="col-3"><strong>@Html.DisplayNameFor(m => m.ModifiedDate)</strong></div>
                    <div class="col-9">@Model.ModifiedDate</div>
                </div>
                <div class="row mb-4">
                    <div class="col-3"><strong>@Html.DisplayNameFor(m => m.ModifiedBy)</strong></div>
                    <div class="col-9">@Model.ModifiedBy</div>
                </div>
            </div>
        </div>
    </div>
</div>
