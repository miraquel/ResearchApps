@model ResearchApps.Service.Vm.ReportVm

@{
    ViewBag.Title = "Reports";
    ViewBag.pTitle = "Report Management";
    Layout = "_Layout";
}

@Html.AntiForgeryToken()

<div class="row" x-data="dataTable({
    url: '/Reports/GetReports',
    method: 'POST',
    primaryKey: 'reportId',
    pageSize: 10,
    defaultSort: 'reportId',
    defaultSortAsc: false,
    columns: [
        { field: 'reportId', label: '@Html.DisplayNameFor(m => m.ReportId)', sortable: true },
        { field: 'reportName', label: '@Html.DisplayNameFor(m => m.ReportName)', sortable: true },
        { field: 'reportType', label: 'Report Type', sortable: true },
        { field: 'pageSize', label: 'Page Size', sortable: true },
        { field: 'statusName', label: '@Html.DisplayNameFor(m => m.StatusName)', sortable: true },
        { field: '_actions', label: 'Actions', sortable: false }
    ]
})">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex align-items-center">
                <h5 class="card-title mb-0 flex-grow-1">Report List</h5>
                <div class="flex-shrink-0 d-flex gap-2">
                    <input type="text" x-model.debounce.500ms="search" placeholder="Search..."
                           class="form-control form-control-sm" style="width: 200px;" />
                    <a href="/Reports/Create" class="btn btn-primary btn-sm">
                        <i class="ri-add-line align-bottom me-1"></i> Add Report
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle mb-0" style="width: 100%;">
                        <thead>
                        <tr>
                            <template x-for="col in columns" :key="col.field">
                                <th class="text-center" style="background-color: #4F81BD; color: white;"
                                    :style="col.field === 'reportId' ? 'width:60px' : col.field === '_actions' ? 'width:120px' : col.field === 'reportType' ? 'width:150px' : col.field === 'pageSize' ? 'width:80px' : col.field === 'statusName' ? 'width:80px' : ''"
                                    :class="{ 'cursor-pointer': col.sortable }"
                                    @@click="col.sortable && sort(col.field)">
                                    <span x-text="col.label"></span>
                                    <i x-show="col.sortable" :class="sortIcon(col.field)" class="ms-1"></i>
                                </th>
                            </template>
                        </tr>
                        </thead>
                        <tbody>
                        <template x-if="isLoading">
                            <tr><td :colspan="columns.length" class="text-center py-4">
                                <span class="spinner-border spinner-border-sm me-2"></span> Loading...
                            </td></tr>
                        </template>
                        <template x-if="!isLoading && items.length === 0">
                            <tr><td :colspan="columns.length" class="text-center py-4 text-muted">
                                No records found.
                            </td></tr>
                        </template>
                        <template x-for="row in items" :key="row.reportId">
                            <tr>
                                <td class="text-center" x-text="row.reportId"></td>
                                <td x-text="row.reportName"></td>
                                <td class="text-center">
                                    <span class="badge"
                                          :class="row.reportType === 1 ? 'bg-primary' : row.reportType === 2 ? 'bg-info' : 'bg-secondary'"
                                          x-text="row.reportType === 1 ? 'Fully Generated' : row.reportType === 2 ? 'Partially Generated' : 'Unknown'">
                                    </span>
                                </td>
                                <td class="text-center" x-text="row.pageSize"></td>
                                <td class="text-center" x-text="row.statusName"></td>
                                <td class="text-center">
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="ri-more-fill align-middle"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a :href="`/Reports/Generate/${row.reportId}`" class="dropdown-item"><i class="ri-play-fill align-bottom me-2 text-success"></i> Generate</a></li>
                                            <li><a :href="`/Reports/Details/${row.reportId}`" class="dropdown-item"><i class="ri-eye-fill align-bottom me-2 text-muted"></i> View</a></li>
                                            <li><a :href="`/Reports/Edit/${row.reportId}`" class="dropdown-item"><i class="ri-pencil-fill align-bottom me-2 text-muted"></i> Edit</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a :href="`/Reports/Delete/${row.reportId}`" class="dropdown-item text-danger"><i class="ri-delete-bin-fill align-bottom me-2"></i> Delete</a></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        </template>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-3" x-show="totalPages > 0">
                    <div class="text-muted" x-show="totalCount > 0">
                        Showing <span x-text="((page - 1) * pageSize) + 1"></span> to
                        <span x-text="Math.min(page * pageSize, totalCount)"></span> of
                        <span x-text="totalCount"></span> entries
                    </div>
                    <nav x-show="totalPages > 1">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item" :class="{ disabled: page === 1 }">
                                <a class="page-link" href="#" @@click.prevent="goToPage(page - 1)">Previous</a>
                            </li>
                            <template x-for="p in pageNumbers" :key="p">
                                <li class="page-item" :class="{ active: p === page }">
                                    <a class="page-link" href="#" @@click.prevent="goToPage(p)" x-text="p"></a>
                                </li>
                            </template>
                            <li class="page-item" :class="{ disabled: page === totalPages }">
                                <a class="page-link" href="#" @@click.prevent="goToPage(page + 1)">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

