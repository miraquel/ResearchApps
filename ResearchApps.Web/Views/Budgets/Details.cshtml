@model ResearchApps.Service.Vm.BudgetVm

@{
    ViewBag.Title = "Budget Details";
    ViewBag.pTitle = $"Budget Details: {Model.BudgetName}";
    Layout = "_Layout";
}

@Html.AntiForgeryToken()

<div id="budgetDetails" class="card">
    <div class="card-header">
        <div class="row">
            <div class="col d-flex justify-content-between align-items-center">
                <ul class="nav nav-tabs-custom rounded card-header-tabs border-bottom-0" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" data-bs-toggle="tab" href="#overview">Overview</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#log">Log</a>
                    </li>
                </ul>
                <div class="position-absolute top-0 end-0">
                    <a asp-action="Edit" asp-route-id="@Model.BudgetId" class="btn btn-sm btn-success me-2">
                        <i class="ri-edit-line"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.BudgetId" class="btn btn-sm btn-danger me-2">
                        <i class="ri-delete-bin-line"></i> Delete
                    </a>
                    <a asp-action="Index" class="btn btn-sm btn-soft-secondary">
                        <i class="ri-arrow-left-line"></i> Back
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="tab-content">
            <!-- Overview Tab -->
            <div class="tab-pane active" id="overview" role="tabpanel">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row mb-4">
                            <div class="col-4"><strong>Budget ID</strong></div>
                            <div class="col-8">@Model.BudgetId</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Budget Name</strong></div>
                            <div class="col-8">@Model.BudgetName</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Year</strong></div>
                            <div class="col-8">@Model.Year</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Start Date</strong></div>
                            <div class="col-8">@Model.StartDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>End Date</strong></div>
                            <div class="col-8">@Model.EndDate.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row mb-4">
                            <div class="col-4"><strong>Amount</strong></div>
                            <div class="col-8">@Model.Amount.ToString("N0")</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Remaining Amount</strong></div>
                            <div class="col-8">@Model.RemAmount.ToString("N0")</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Used Amount</strong></div>
                            <div class="col-8">@((Model.Amount - Model.RemAmount).ToString("N0"))</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Status</strong></div>
                            <div class="col-8">@Html.Raw(Model.StatusName)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Log Tab -->
            <div class="tab-pane" id="log" role="tabpanel">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row mb-4">
                            <div class="col-4"><strong>Created Date</strong></div>
                            <div class="col-8">@(Model.CreatedDate?.ToString("dd MMM yyyy HH:mm:ss") ?? "-")</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Created By</strong></div>
                            <div class="col-8">@(string.IsNullOrEmpty(Model.CreatedBy) ? "-" : Model.CreatedBy)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row mb-4">
                            <div class="col-4"><strong>Modified Date</strong></div>
                            <div class="col-8">@(Model.ModifiedDate?.ToString("dd MMM yyyy HH:mm:ss") ?? "-")</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Modified By</strong></div>
                            <div class="col-8">@(string.IsNullOrEmpty(Model.ModifiedBy) ? "-" : Model.ModifiedBy)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
