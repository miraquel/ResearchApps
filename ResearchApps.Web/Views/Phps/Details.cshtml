@model ResearchApps.Service.Vm.PhpVm

@{
    ViewBag.Title = "Penerimaan Hasil Produksi Details";
    ViewBag.pTitle = $"PHP No. {Model.Header.PhpId}";
    Layout = "_Layout";
    
    var statusBadgeClass = Model.Header.PhpStatusId switch
    {
        0 => "bg-warning",    // Draft
        1 => "bg-success",    // Active
        2 => "bg-primary",    // Closed
        3 => "bg-danger",     // Cancelled
        _ => "bg-secondary"
    };
}

<div x-data="phpDetails()" x-init="init()">
    @Html.AntiForgeryToken()

    <div id="phpDetails" class="card">
        <div class="card-header">
            <div class="row">
                <div class="col d-flex justify-content-between align-items-end">
                    <ul class="nav nav-tabs-custom rounded card-header-tabs border-bottom-0" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link active" data-bs-toggle="tab" href="#overview">Overview</a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" data-bs-toggle="tab" href="#lines">Lines</a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" data-bs-toggle="tab" href="#log">Log</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2 align-self-center">
                        <a asp-action="Index" class="btn btn-sm btn-soft-secondary">
                            <i class="ri-arrow-left-line"></i> Back
                        </a>
                        @if (Model.CanEdit)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Header.RecId" class="btn btn-sm btn-success">
                                <i class="ri-edit-line"></i> Edit
                            </a>
                        }
                        @if (Model.CanDelete)
                        {
                            <button type="button" class="btn btn-sm btn-danger" @@click="showDeleteConfirm = true">
                                <i class="ri-delete-bin-line"></i> Delete
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="tab-content">
                <div class="tab-pane active" id="overview" role="tabpanel">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row mb-4">
                                <div class="col-4"><strong>PHP No</strong></div>
                                <div class="col-8">@Model.Header.PhpId</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>PHP Date</strong></div>
                                <div class="col-8">@Model.Header.PhpDate.ToString("dd MMM yyyy")</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>Description</strong></div>
                                <div class="col-8">@(string.IsNullOrEmpty(Model.Header.Descr) ? "-" : Model.Header.Descr)</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-4">
                                <div class="col-4"><strong>Reference ID</strong></div>
                                <div class="col-8">@(string.IsNullOrEmpty(Model.Header.RefId) ? "-" : Model.Header.RefId)</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>Status</strong></div>
                                <div class="col-8"><span class="badge @statusBadgeClass">@Model.Header.PhpStatusName</span></div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>Notes</strong></div>
                                <div class="col-8">@(string.IsNullOrEmpty(Model.Header.Notes) ? "-" : Model.Header.Notes)</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>Total Amount</strong></div>
                                <div class="col-8 fw-semibold text-primary">@Model.Header.Amount.ToString("N0")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane" id="lines" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center" style="width: 50px;">#</th>
                                    <th style="min-width: 200px;">Item</th>
                                    <th style="width: 120px;">Warehouse</th>
                                    <th class="text-end" style="width: 100px;">Qty</th>
                                    <th class="text-center" style="width: 80px;">Unit</th>
                                    <th class="text-end" style="width: 120px;">Price</th>
                                    <th style="width: 120px;">Prod ID</th>
                                    <th style="width: 150px;">Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Lines.Any())
                                {
                                    var lineIndex = 1;
                                    foreach (var line in Model.Lines)
                                    {
                                        <tr>
                                            <td class="text-center">@lineIndex</td>
                                            <td>@line.ItemName</td>
                                            <td>@line.WhName</td>
                                            <td class="text-end">@line.Qty.ToString("N0")</td>
                                            <td class="text-center">@line.UnitName</td>
                                            <td class="text-end">@line.Price.ToString("N0")</td>
                                            <td>@(line.ProdId ?? "-")</td>
                                            <td>@(string.IsNullOrEmpty(line.Notes) ? "-" : line.Notes)</td>
                                        </tr>
                                        lineIndex++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">No lines found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane" id="log" role="tabpanel">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row mb-4">
                                <div class="col-4"><strong>Created By</strong></div>
                                <div class="col-8">@Model.Header.CreatedBy</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>Created Date</strong></div>
                                <div class="col-8">@Model.Header.CreatedDate.ToString("dd MMM yyyy HH:mm:ss")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-4">
                                <div class="col-4"><strong>Modified By</strong></div>
                                <div class="col-8">@Model.Header.ModifiedBy</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>Modified Date</strong></div>
                                <div class="col-8">@Model.Header.ModifiedDate.ToString("dd MMM yyyy HH:mm:ss")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Delete Confirmation Modal -->
    <div class="modal fade" 
         :class="{ 'show d-block': showDeleteConfirm }"
         x-show="showDeleteConfirm"
         x-cloak
         tabindex="-1"
         @@click.self="showDeleteConfirm = false"
         @@keydown.escape.window="showDeleteConfirm = false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="ri-error-warning-line me-2"></i>Confirm Delete
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @@click="showDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete PHP <strong>@Model.Header.PhpId</strong>?</p>
                    <p class="text-danger mb-0"><small>This action cannot be undone and all lines will be deleted.</small></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @@click="showDeleteConfirm = false">Cancel</button>
                    <form method="post" action="/Phps/Delete/@Model.Header.RecId">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="ri-delete-bin-line me-1"></i> Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show" x-show="showDeleteConfirm" x-cloak></div>
</div>

@section scripts {
    <script src="~/js/phps/php-details.js"></script>
}
