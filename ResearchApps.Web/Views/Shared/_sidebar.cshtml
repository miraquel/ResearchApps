@using ResearchApps.Common.Constants
@inject ResearchApps.Web.Services.ITenantFeatureService TenantFeatures
<!-- ========== App Menu ========== -->
<div class="app-menu navbar-menu">
    <!-- LOGO -->
    <div class="navbar-brand-box">
        <!-- Dark Logo-->
        <a href="@Url.Action("Index", "Home")" class="logo logo-dark">
            <span class="logo-sm">
                <img src="~/assets/images/logo-sm.webp" alt="" height="22">
            </span>
            <span class="logo-lg">
                <img src="~/assets/images/logo.webp" alt="" height="40">
            </span>
        </a>
        <!-- Light Logo-->
        <a href="@Url.Action("Index", "Home")" class="logo logo-light">
            <span class="logo-sm">
                <img src="~/assets/images/logo-sm.webp" alt="" height="22">
            </span>
            <span class="logo-lg">
                <img src="~/assets/images/logo-dark.webp" alt="" height="40">
            </span>
        </a>
        <button type="button" class="btn btn-sm p-0 fs-20 header-item float-end btn-vertical-sm-hover" id="vertical-hover">
            <i class="ri-record-circle-line"></i>
        </button>
    </div>

    <div id="scrollbar">
        <div class="container-fluid">

            <div id="two-column-menu">
            </div>
            <ul class="navbar-nav" id="navbar-nav">
                <li class="menu-title"><span data-key="t-menu">Menu</span></li>
                
                <!-- Dashboard -->
                <li class="nav-item">
                    <a class="nav-link menu-link" href="@Url.Action("Index", "Home", new { Area = "" })">
                        <i class="ri-home-2-fill"></i> <span data-key="t-home">Home</span>
                    </a>
                </li>

                <!-- Sales Management -->
                @{
                    var hasSalesAccess = (TenantFeatures.IsEnabled(TenantFeatureConstants.Customers) && User.HasClaim("permission", PermissionConstants.Customers.Index)) ||
                                         (TenantFeatures.IsEnabled(TenantFeatureConstants.CustomerOrders) && User.HasClaim("permission", PermissionConstants.CustomerOrders.Index)) ||
                                         (TenantFeatures.IsEnabled(TenantFeatureConstants.DeliveryOrders) && User.HasClaim("permission", PermissionConstants.DeliveryOrders.Index)) ||
                                         (TenantFeatures.IsEnabled(TenantFeatureConstants.SalesInvoices) && User.HasClaim("permission", PermissionConstants.SalesInvoices.Index)) ||
                                         (TenantFeatures.IsEnabled(TenantFeatureConstants.SalesPrices) && User.HasClaim("permission", PermissionConstants.SalesPrices.Index));
                }
                @if (hasSalesAccess)
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link" href="#sidebarSales" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="sidebarSales">
                            <i class="ri-store-2-line"></i> <span data-key="t-sales">Sales</span>
                        </a>
                        <div class="collapse menu-dropdown" id="sidebarSales">
                            <ul class="nav nav-sm flex-column">
                                <tenant-feature name="@TenantFeatureConstants.Customers">
                                @if (User.HasClaim("permission", PermissionConstants.Customers.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Customers", new { Area = "" })" class="nav-link" data-key="t-customers">
                                            Customers
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.CustomerOrders">
                                @if (User.HasClaim("permission", PermissionConstants.CustomerOrders.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "CustomerOrders", new { Area = "" })" class="nav-link" data-key="t-customer-orders">
                                            Customer Orders
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.DeliveryOrders">
                                @if (User.HasClaim("permission", PermissionConstants.DeliveryOrders.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "DeliveryOrders", new { Area = "" })" class="nav-link" data-key="t-delivery-orders">
                                            Delivery Orders
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.SalesInvoices">
                                @if (User.HasClaim("permission", PermissionConstants.SalesInvoices.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "SalesInvoices", new { Area = "" })" class="nav-link" data-key="t-sales-invoices">
                                            Sales Invoices
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.SalesPrices">
                                @if (User.HasClaim("permission", PermissionConstants.SalesPrices.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "SalesPrices", new { Area = "" })" class="nav-link" data-key="t-sales-prices">
                                            Sales Prices
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                            </ul>
                        </div>
                    </li>
                }

                <!-- Procurement -->
                @{
                    var hasProcurementAccess = (TenantFeatures.IsEnabled(TenantFeatureConstants.Budgets) && User.HasClaim("permission", PermissionConstants.Budgets.Index)) ||
                                               (TenantFeatures.IsEnabled(TenantFeatureConstants.PurchaseRequisitions) && User.HasClaim("permission", PermissionConstants.Prs.Index)) ||
                                               (TenantFeatures.IsEnabled(TenantFeatureConstants.PurchaseOrders) && User.HasClaim("permission", PermissionConstants.Pos.Index)) ||
                                               (TenantFeatures.IsEnabled(TenantFeatureConstants.GoodsReceipts) && User.HasClaim("permission", PermissionConstants.GoodsReceipts.Index)) ||
                                               (TenantFeatures.IsEnabled(TenantFeatureConstants.Suppliers) && User.HasClaim("permission", PermissionConstants.Suppliers.Index));
                }
                @if (hasProcurementAccess)
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link" href="#sidebarProcurement" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="sidebarProcurement">
                            <i class="ri-shopping-cart-line"></i> <span data-key="t-procurement">Procurement</span>
                        </a>
                        <div class="collapse menu-dropdown" id="sidebarProcurement">
                            <ul class="nav nav-sm flex-column">
                                <tenant-feature name="@TenantFeatureConstants.Budgets">
                                @if (User.HasClaim("permission", PermissionConstants.Budgets.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Budgets", new { Area = "" })" class="nav-link" data-key="t-budgets">
                                            Budgets
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.Suppliers">
                                @if (User.HasClaim("permission", PermissionConstants.Suppliers.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Suppliers", new { Area = "" })" class="nav-link" data-key="t-suppliers">
                                            Suppliers
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.PurchaseRequisitions">
                                @if (User.HasClaim("permission", PermissionConstants.Prs.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Prs", new { Area = "" })" class="nav-link" data-key="t-prs">
                                            Purchase Requisitions
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.PurchaseOrders">
                                @if (User.HasClaim("permission", PermissionConstants.Pos.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Pos", new { Area = "" })" class="nav-link" data-key="t-pos">
                                            Purchase Orders
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.GoodsReceipts">
                                @if (User.HasClaim("permission", PermissionConstants.GoodsReceipts.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "GoodsReceipts", new { Area = "" })" class="nav-link" data-key="t-goods-receipts">
                                            Goods Receipts
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                            </ul>
                        </div>
                    </li>
                }

                <!-- Inventory Management -->
                @{
                    var hasInventoryAccess = (TenantFeatures.IsEnabled(TenantFeatureConstants.Items) && User.HasClaim("permission", PermissionConstants.Items.Index)) ||
                                             (TenantFeatures.IsEnabled(TenantFeatureConstants.ItemTypes) && User.HasClaim("permission", PermissionConstants.ItemTypes.Index)) ||
                                             (TenantFeatures.IsEnabled(TenantFeatureConstants.ItemDepts) && User.HasClaim("permission", PermissionConstants.ItemDepts.Index)) ||
                                             (TenantFeatures.IsEnabled(TenantFeatureConstants.ItemGroup01s) && User.HasClaim("permission", PermissionConstants.ItemGroup01s.Index)) ||
                                             (TenantFeatures.IsEnabled(TenantFeatureConstants.ItemGroup02s) && User.HasClaim("permission", PermissionConstants.ItemGroup02s.Index)) ||
                                             (TenantFeatures.IsEnabled(TenantFeatureConstants.Warehouses) && User.HasClaim("permission", PermissionConstants.Warehouses.Index)) ||
                                             (TenantFeatures.IsEnabled(TenantFeatureConstants.Units) && User.HasClaim("permission", PermissionConstants.Units.Index)) ||
                                             (TenantFeatures.IsEnabled(TenantFeatureConstants.StockAdjustments) && User.HasClaim("permission", PermissionConstants.Pss.Index)) ||
                                             (TenantFeatures.IsEnabled(TenantFeatureConstants.StockReport) && User.HasClaim("permission", PermissionConstants.RepStock.Index));
                }
                @if (hasInventoryAccess)
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link" href="#sidebarInventory" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="sidebarInventory">
                            <i class="ri-database-2-line"></i> <span data-key="t-inventory">Inventory</span>
                        </a>
                        <div class="collapse menu-dropdown" id="sidebarInventory">
                            <ul class="nav nav-sm flex-column">
                                <tenant-feature name="@TenantFeatureConstants.Items">
                                @if (User.HasClaim("permission", PermissionConstants.Items.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Items", new { Area = "" })" class="nav-link" data-key="t-items">
                                            Items
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.ItemTypes">
                                @if (User.HasClaim("permission", PermissionConstants.ItemTypes.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "ItemTypes", new { Area = "" })" class="nav-link" data-key="t-item-types">
                                            Item Types
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.ItemDepts">
                                @if (User.HasClaim("permission", PermissionConstants.ItemDepts.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "ItemDepts", new { Area = "" })" class="nav-link" data-key="t-item-departments">
                                            Item Departments
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.ItemGroup01s">
                                @if (User.HasClaim("permission", PermissionConstants.ItemGroup01s.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "ItemGroup01s", new { Area = "" })" class="nav-link" data-key="t-item-group-01">
                                            Item Group 01
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.ItemGroup02s">
                                @if (User.HasClaim("permission", PermissionConstants.ItemGroup02s.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "ItemGroup02s", new { Area = "" })" class="nav-link" data-key="t-item-group-02">
                                            Item Group 02
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.Warehouses">
                                @if (User.HasClaim("permission", PermissionConstants.Warehouses.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Warehouses", new { Area = "" })" class="nav-link" data-key="t-warehouses">
                                            Warehouses
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.Units">
                                @if (User.HasClaim("permission", PermissionConstants.Units.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Units", new { Area = "" })" class="nav-link" data-key="t-units">
                                            Units
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.StockAdjustments">
                                @if (User.HasClaim("permission", PermissionConstants.Pss.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Pss", new { Area = "" })" class="nav-link" data-key="t-penyesuaian-stock">
                                            Penyesuaian Stock
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.StockReport">
                                @if (User.HasClaim("permission", PermissionConstants.RepStock.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "RepStock", new { Area = "" })" class="nav-link" data-key="t-rep-stock">
                                            Stock Report
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                            </ul>
                        </div>
                    </li>
                }

                <!-- Production -->
                @{
                    var hasProductionAccess = (TenantFeatures.IsEnabled(TenantFeatureConstants.ProductionOrders) && User.HasClaim("permission", PermissionConstants.Prods.Index)) ||
                                              (TenantFeatures.IsEnabled(TenantFeatureConstants.MaterialWithdrawals) && User.HasClaim("permission", PermissionConstants.Bpbs.Index)) || 
                                              (TenantFeatures.IsEnabled(TenantFeatureConstants.MaterialCustomers) && User.HasClaim("permission", PermissionConstants.MaterialCustomers.Index)) ||
                                              (TenantFeatures.IsEnabled(TenantFeatureConstants.Phps) && User.HasClaim("permission", PermissionConstants.Phps.Index)) ||
                                              (TenantFeatures.IsEnabled(TenantFeatureConstants.ToolsReport) && User.HasClaim("permission", PermissionConstants.RepCustom.Index));
                }
                @if (hasProductionAccess)
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link" href="#sidebarProduction" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="sidebarProduction">
                            <i class="ri-tools-line"></i> <span data-key="t-production">Production</span>
                        </a>
                        <div class="collapse menu-dropdown" id="sidebarProduction">
                            <ul class="nav nav-sm flex-column">
                                <tenant-feature name="@TenantFeatureConstants.ProductionOrders">
                                @if (User.HasClaim("permission", PermissionConstants.Prods.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Prods", new { Area = "" })" class="nav-link" data-key="t-prods">
                                            Production Orders
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.MaterialCustomers">
                                @if (User.HasClaim("permission", PermissionConstants.MaterialCustomers.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "MaterialCustomers", new { Area = "" })" class="nav-link" data-key="t-material-customers">
                                            Material Customers
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.MaterialWithdrawals">
                                @if (User.HasClaim("permission", PermissionConstants.Bpbs.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Bpbs", new { Area = "" })" class="nav-link" data-key="t-bpbs">
                                            Material Withdrawals (BPB)
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.Phps">
                                @if (User.HasClaim("permission", PermissionConstants.Phps.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Phps", new { Area = "" })" class="nav-link" data-key="t-phps">
                                            Penerimaan Hasil Produksi (PHP)
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.ToolsReport">
                                @if (User.HasClaim("permission", PermissionConstants.RepCustom.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "RepCustom", new { Area = "" })" class="nav-link" data-key="t-rep-custom">
                                            Tools Report
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                            </ul>
                        </div>
                    </li>
                }

                <!-- Finance -->
                @{
                    var hasFinanceAccess = (TenantFeatures.IsEnabled(TenantFeatureConstants.InventoryClosing) && User.HasClaim("permission", PermissionConstants.InventLocks.Index)) ||
                                          (TenantFeatures.IsEnabled(TenantFeatureConstants.TermsOfPayment) && User.HasClaim("permission", PermissionConstants.Tops.Index)) ||
                                          (TenantFeatures.IsEnabled(TenantFeatureConstants.InventTransReport) && User.HasClaim("permission", PermissionConstants.RepInventTrans.Index));
                }
                @if (hasFinanceAccess)
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link" href="#sidebarFinance" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="sidebarFinance">
                            <i class="ri-money-dollar-circle-line"></i> <span data-key="t-finance">Finance</span>
                        </a>
                        <div class="collapse menu-dropdown" id="sidebarFinance">
                            <ul class="nav nav-sm flex-column">
                                <tenant-feature name="@TenantFeatureConstants.TermsOfPayment">
                                @if (User.HasClaim("permission", PermissionConstants.Tops.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Tops", new { Area = "" })" class="nav-link" data-key="t-tops">
                                            Terms of Payment
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.InventoryClosing">
                                @if (User.HasClaim("permission", PermissionConstants.InventLocks.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "InventLocks", new { Area = "" })" class="nav-link" data-key="t-inventory-closing">
                                            Inventory Closing
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                                
                                <tenant-feature name="@TenantFeatureConstants.InventTransReport">
                                @if (User.HasClaim("permission", PermissionConstants.RepInventTrans.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "RepInventTrans", new { Area = "" })" class="nav-link" data-key="t-rep-inventtrans">
                                            Invent Trans Report
                                        </a>
                                    </li>
                                }
                                </tenant-feature>
                            </ul>
                        </div>
                    </li>
                }

                <!-- Reports -->
                <tenant-feature name="@TenantFeatureConstants.Reports">
                @if (User.HasClaim("permission", PermissionConstants.Reports.Index))
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link" href="@Url.Action("Index", "Reports", new { Area = "" })">
                            <i class="ri-file-chart-line"></i> <span data-key="t-reports">Reports</span>
                        </a>
                    </li>
                }
                </tenant-feature>

                <!-- Administration -->
                @{
                    var hasAdminAccess = User.HasClaim("permission", PermissionConstants.Users.Index) ||
                                         User.HasClaim("permission", PermissionConstants.Roles.Index) ||
                                         User.HasClaim("permission", PermissionConstants.Workflows.Index) ||
                                         User.HasClaim("permission", PermissionConstants.Tenants.Index);
                }
                @if (hasAdminAccess)
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link" href="#sidebarAdmin" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="sidebarAdmin">
                            <i class="ri-settings-3-line"></i> <span data-key="t-admin">Administration</span>
                        </a>
                        <div class="collapse menu-dropdown" id="sidebarAdmin">
                            <ul class="nav nav-sm flex-column">
                                @if (User.HasClaim("permission", PermissionConstants.Users.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Users", new { Area = "Admin" })" class="nav-link" data-key="t-users">
                                            Users
                                        </a>
                                    </li>
                                }
                                
                                @if (User.HasClaim("permission", PermissionConstants.Roles.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Roles", new { Area = "Admin" })" class="nav-link" data-key="t-roles">
                                            Roles
                                        </a>
                                    </li>
                                }
                                
                                @if (User.HasClaim("permission", PermissionConstants.Workflows.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Workflows", new { Area = "Admin" })" class="nav-link" data-key="t-workflows">
                                            Workflows
                                        </a>
                                    </li>
                                }
                                
                                @if (User.HasClaim("permission", PermissionConstants.Tenants.Index))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Tenants", new { Area = "Admin" })" class="nav-link" data-key="t-tenants">
                                            Tenants
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                }
            </ul>
        </div>
        <!-- Sidebar -->
    </div>
    <div class="sidebar-background"></div>
</div>
<!-- Left Sidebar End -->
<!-- Vertical Overlay-->
<div class="vertical-overlay"></div>