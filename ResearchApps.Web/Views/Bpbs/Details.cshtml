@model ResearchApps.Service.Vm.BpbVm

@{
    ViewBag.Title = "BPB Details";
    ViewBag.pTitle = $"BPB {Model.Header.BpbId}";
    Layout = "_Layout";
}

@Html.AntiForgeryToken()

<div id="bpbDetails" class="card">
    <div class="card-header">
        <div class="row">
            <div class="col d-flex justify-content-between align-items-end">
                <ul class="nav nav-tabs-custom rounded card-header-tabs border-bottom-0" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" data-bs-toggle="tab" href="#overview">Overview</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#lines">Lines</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#log">Log</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2 align-self-center">
                    <a asp-action="Index" class="btn btn-sm btn-soft-secondary">
                        <i class="ri-arrow-left-line"></i> Back
                    </a>
                    @if (Model.CanEdit)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Header.RecId" class="btn btn-sm btn-success">
                            <i class="ri-edit-line"></i> Edit
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.Header.RefId))
                    {
                        <a asp-controller="Prods" asp-action="Details" asp-route-prodId="@Model.Header.RefId" class="btn btn-sm btn-info">
                            <i class="ri-external-link-line"></i> View Production
                        </a>
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">
                        <i class="ri-printer-line"></i> Print
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="tab-content">
            <div class="tab-pane active" id="overview" role="tabpanel">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row mb-4">
                            <div class="col-4"><strong>BPB No</strong></div>
                            <div class="col-8">@Model.Header.BpbId</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>BPB Date</strong></div>
                            <div class="col-8">@Model.Header.BpbDateStr</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Production ID</strong></div>
                            <div class="col-8">
                                @if (!string.IsNullOrEmpty(Model.Header.RefId))
                                {
                                    <a asp-controller="Prods" asp-action="Details" asp-route-prodId="@Model.Header.RefId">@Model.Header.RefId</a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Description</strong></div>
                            <div class="col-8">@(string.IsNullOrEmpty(Model.Header.Descr) ? "-" : Model.Header.Descr)</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Notes</strong></div>
                            <div class="col-8">@(string.IsNullOrEmpty(Model.Header.Notes) ? "-" : Model.Header.Notes)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row mb-4">
                            <div class="col-4"><strong>Status</strong></div>
                            <div class="col-8">@Html.Raw(Model.Header.BpbStatusName)</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Total Amount</strong></div>
                            <div class="col-8 fw-semibold text-primary">@Model.Header.Amount.ToString("N0")</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tab-pane" id="lines" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center" style="width: 50px;">#</th>
                                <th>Item</th>
                                <th style="width: 150px;">Warehouse</th>
                                <th class="text-end" style="width: 100px;">Qty</th>
                                <th style="width: 80px;">Unit</th>
                                <th class="text-end" style="width: 120px;">Price</th>
                                <th class="text-end" style="width: 130px;">Amount</th>
                                <th style="width: 150px;">Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Lines.Any())
                            {
                                var lineNo = 1;
                                foreach (var line in Model.Lines)
                                {
                                    <tr>
                                        <td class="text-center">@lineNo</td>
                                        <td>@line.ItemName</td>
                                        <td>@line.WhName</td>
                                        <td class="text-end">@line.Qty.ToString("N2")</td>
                                        <td>@line.UnitName</td>
                                        <td class="text-end">@line.Price.ToString("N0")</td>
                                        <td class="text-end">@line.Amount.ToString("N0")</td>
                                        <td>@(string.IsNullOrEmpty(line.Notes) ? "-" : line.Notes)</td>
                                    </tr>
                                    lineNo++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">No line items.</td>
                                </tr>
                            }
                        </tbody>
                        @if (Model.Lines.Any())
                        {
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="6" class="text-end">Total:</th>
                                    <th class="text-end">@Model.Lines.Sum(l => l.Amount).ToString("N0")</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
            <div class="tab-pane" id="log" role="tabpanel">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row mb-4">
                            <div class="col-4"><strong>Created By</strong></div>
                            <div class="col-8">@Model.Header.CreatedBy</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Created Date</strong></div>
                            <div class="col-8">@Model.Header.CreatedDate.ToString("dd MMM yyyy HH:mm:ss")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row mb-4">
                            <div class="col-4"><strong>Modified By</strong></div>
                            <div class="col-8">@Model.Header.ModifiedBy</div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-4"><strong>Modified Date</strong></div>
                            <div class="col-8">@Model.Header.ModifiedDate.ToString("dd MMM yyyy HH:mm:ss")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
