@model ResearchApps.Service.Vm.GoodsReceiptVm

@{
    ViewBag.Title = "Delete Goods Receipt";
    ViewBag.pTitle = $"Delete Goods Receipt No. {Model.Header.GrId}";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="card-title mb-0">
                    <i class="ri-alert-line"></i> Confirm Delete
                </h5>
            </div>
            <div class="card-body">
                <div class="alert alert-danger mb-4">
                    <i class="ri-error-warning-fill me-2"></i>
                    <strong>Warning!</strong> You are about to delete this Goods Receipt. This action cannot be undone.
                </div>

                <h6 class="fw-bold mb-3">Goods Receipt Details:</h6>
                <table class="table table-bordered">
                    <tr>
                        <td class="fw-semibold text-muted" style="width: 200px;">GR No</td>
                        <td>@Model.Header.GrId</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold text-muted">GR Date</td>
                        <td>@Model.Header.GrDate.ToString("dd MMM yyyy")</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold text-muted">Supplier</td>
                        <td>@Model.Header.SupplierName</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold text-muted">Reference No</td>
                        <td>@(string.IsNullOrEmpty(Model.Header.RefNo) ? "-" : Model.Header.RefNo)</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold text-muted">Status</td>
                        <td>
                            <span class="badge @(Model.Header.GrStatusId == 0 ? "bg-warning" : "bg-success")">
                                @Model.Header.GrStatusName
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-semibold text-muted">Subtotal</td>
                        <td>@Model.Header.SubTotal.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold text-muted">PPN (11%)</td>
                        <td>@Model.Header.Ppn.ToString("N0")</td>
                    </tr>
                    <tr class="table-warning">
                        <td class="fw-bold">Total</td>
                        <td class="fw-bold text-primary">@Model.Header.Total.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold text-muted">Created By</td>
                        <td>@Model.Header.CreatedBy on @Model.Header.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                    </tr>
                </table>

                <form action="/GoodsReceipts/Delete/@Model.Header.RecId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-danger">
                            <i class="ri-delete-bin-line me-1"></i> Confirm Delete
                        </button>
                        <a href="/GoodsReceipts/Details/@Model.Header.RecId" class="btn btn-secondary">
                            <i class="ri-arrow-left-line me-1"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
