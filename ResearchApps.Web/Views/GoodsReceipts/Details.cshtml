@model ResearchApps.Service.Vm.GoodsReceiptVm

@{
    ViewBag.Title = "Goods Receipt Details";
    ViewBag.pTitle = $"Goods Receipt No. {Model.Header.GrId}";
    Layout = "_Layout";
    
    var statusBadgeClass = Model.Header.GrStatusId switch
    {
        0 => "bg-warning",    // Draft
        1 => "bg-success",    // Posted
        _ => "bg-secondary"
    };
}

<div x-data="grDetails()" x-init="init()">
    @Html.AntiForgeryToken()

    <div id="grDetails" class="card">
        <div class="card-header">
            <div class="row">
                <div class="col d-flex justify-content-between align-items-end">
                    <ul class="nav nav-tabs-custom rounded card-header-tabs border-bottom-0" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link active" data-bs-toggle="tab" href="#overview">Overview</a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" data-bs-toggle="tab" href="#lines">Lines</a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" data-bs-toggle="tab" href="#log">Log</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2 align-self-center">
                        <a asp-action="Index" class="btn btn-sm btn-soft-secondary">
                            <i class="ri-arrow-left-line"></i> Back
                        </a>
                        @if (Model.CanEdit)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Header.RecId" class="btn btn-sm btn-success">
                                <i class="ri-edit-line"></i> Edit
                            </a>
                        }
                        @if (Model.CanDelete)
                        {
                            <button type="button" class="btn btn-sm btn-danger" @@click="showDeleteConfirm = true">
                                <i class="ri-delete-bin-line"></i> Delete
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="tab-content">
                <div class="tab-pane active" id="overview" role="tabpanel">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row mb-4">
                                <div class="col-4"><strong>GR No</strong></div>
                                <div class="col-8">@Model.Header.GrId</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>GR Date</strong></div>
                                <div class="col-8">@Model.Header.GrDate.ToString("dd MMM yyyy")</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>Supplier</strong></div>
                                <div class="col-8">@Model.Header.SupplierName</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>Reference No</strong></div>
                                <div class="col-8">@(string.IsNullOrEmpty(Model.Header.RefNo) ? "-" : Model.Header.RefNo)</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-4">
                                <div class="col-4"><strong>Status</strong></div>
                                <div class="col-8"><span class="badge @statusBadgeClass">@Model.Header.GrStatusName</span></div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>Notes</strong></div>
                                <div class="col-8">@(string.IsNullOrEmpty(Model.Header.Notes) ? "-" : Model.Header.Notes)</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>Subtotal</strong></div>
                                <div class="col-8">@Model.Header.SubTotal.ToString("N0")</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>PPN (11%)</strong></div>
                                <div class="col-8">@Model.Header.Ppn.ToString("N0")</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>Grand Total</strong></div>
                                <div class="col-8 fw-semibold text-primary">@Model.Header.Total.ToString("N0")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane" id="lines" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center" style="width: 50px;">#</th>
                                    <th style="min-width: 150px;">Item</th>
                                    <th style="min-width: 200px;">Description</th>
                                    <th class="text-end" style="width: 100px;">Qty Received</th>
                                    <th class="text-center" style="width: 80px;">Unit</th>
                                    <th class="text-end" style="width: 120px;">Price</th>
                                    <th class="text-end" style="width: 130px;">Amount</th>
                                    <th style="width: 150px;">Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Lines.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">No lines found.</td>
                                    </tr>
                                }
                                else
                                {
                                    var lineNo = 0;
                                    @foreach (var line in Model.Lines)
                                    {
                                        lineNo++;
                                        <tr>
                                            <td class="text-center">@lineNo</td>
                                            <td>@line.ItemName</td>
                                            <td>@(string.IsNullOrEmpty(line.Description) ? "-" : line.Description)</td>
                                            <td class="text-end">@line.Qty.ToString("N2")</td>
                                            <td class="text-center">@line.UnitName</td>
                                            <td class="text-end">@line.Price.ToString("N0")</td>
                                            <td class="text-end">@line.Amount.ToString("N0")</td>
                                            <td>@(string.IsNullOrEmpty(line.Notes) ? "-" : line.Notes)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="6" class="text-end">Subtotal:</th>
                                    <th class="text-end">@Model.Header.SubTotal.ToString("N0")</th>
                                    <th></th>
                                </tr>
                                <tr>
                                    <th colspan="6" class="text-end">Grand Total:</th>
                                    <th class="text-end">@Model.Header.Total.ToString("N0")</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="tab-pane" id="log" role="tabpanel">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row mb-4">
                                <div class="col-4"><strong>Created By</strong></div>
                                <div class="col-8">@Model.Header.CreatedBy</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-4"><strong>Created Date</strong></div>
                                <div class="col-8">@Model.Header.CreatedDate.ToString("dd MMM yyyy HH:mm:ss")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            @if (Model.Header.ModifiedDate != default)
                            {
                                <div class="row mb-4">
                                    <div class="col-4"><strong>Modified By</strong></div>
                                    <div class="col-8">@Model.Header.ModifiedBy</div>
                                </div>
                                <div class="row mb-4">
                                    <div class="col-4"><strong>Modified Date</strong></div>
                                    <div class="col-8">@Model.Header.ModifiedDate.ToString("dd MMM yyyy HH:mm:ss")</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Delete Confirmation Modal -->
    <div class="modal fade" 
         :class="{ 'show d-block': showDeleteConfirm }"
         x-show="showDeleteConfirm"
         x-cloak
         tabindex="-1"
         @@click.self="showDeleteConfirm = false"
         @@keydown.escape.window="showDeleteConfirm = false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">
                        <i class="ri-error-warning-line me-2"></i>Confirm Delete
                    </h5>
                    <button type="button" class="btn-close" @@click="showDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this Goods Receipt?</p>
                    <p class="text-muted mb-0">This action cannot be undone. All lines will also be deleted.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @@click="showDeleteConfirm = false">Cancel</button>
                    <button type="button" 
                            class="btn btn-danger" 
                            :disabled="isProcessing"
                            @@click="deleteGr()">
                        <span x-show="!isProcessing">
                            <i class="ri-delete-bin-line me-1"></i> Delete
                        </span>
                        <span x-show="isProcessing" x-cloak>
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            Deleting...
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show" x-show="showDeleteConfirm" x-cloak></div>
</div>

@section scripts {
    <script>
        function grDetails() {
            return {
                recId: @Model.Header.RecId,
                showDeleteConfirm: false,
                isProcessing: false,
                
                init() {
                    // Any initialization
                },
                
                async deleteGr() {
                    this.isProcessing = true;
                    try {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                        const response = await fetch(`/api/GoodsReceipts/${this.recId}`, {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            }
                        });
                        
                        if (response.ok) {
                            toastr.success('Goods Receipt deleted successfully');
                            setTimeout(() => window.location.href = '/GoodsReceipts', 1000);
                        } else {
                            const data = await response.json();
                            toastr.error(data.message || 'Failed to delete Goods Receipt');
                        }
                    } catch (error) {
                        console.error('Error deleting GR:', error);
                        toastr.error('An error occurred while deleting');
                    } finally {
                        this.isProcessing = false;
                        this.showDeleteConfirm = false;
                    }
                }
            };
        }
    </script>
}
