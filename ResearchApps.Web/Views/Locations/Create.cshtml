@model ResearchApps.Service.Vm.LocationVm

@{
    ViewBag.Title = "Create Location";
    ViewBag.pTitle = "Create Location";
    Layout = "_Layout";
}

@* Alpine.js component for location creation form *@
<div x-data="locationCreate()">
    @* Form card *@
    <div class="card">
        <div class="card-body">
            <form id="location-form" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="StatusId" value="1" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="LocationName" class="form-label"></label>
                            <input asp-for="LocationName" class="form-control" placeholder="Enter location name" required />
                            <span asp-validation-for="LocationName" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary"
                            data-confirm
                            data-confirm-modal="createLocationModal"
                            data-confirm-form="#location-form"
                            data-confirm-validate="true"
                            data-confirm-title="Confirm Create"
                            data-confirm-message="Are you sure you want to create this location?">
                        <i class="ri-save-line align-bottom me-1"></i> Create
                    </button>
                    <a asp-action="Index" class="btn btn-soft-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/locations/location-create.js"></script>
}
